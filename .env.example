# Данные MTProto-приложения с https://my.telegram.org/apps (нужен обычный TG-аккаунт)
TG_API_ID=12345678
TG_API_HASH=abcdef0123456789abcdef0123456789

# Токен бота от @BotFather. Бот должен быть админом целевого канала
TG_BOT_TOKEN=123456:ABC-DEF...

# Куда постить: @username канала или числовой id вида -1001234567890
TG_TARGET_CHANNEL=@my_ai_digest

# Кто может управлять списком каналов через бота (/add, /remove) — id через запятую.
# Свой id узнать: напишите боту любое сообщение, он ответит "Ваш id: ...".
BOT_ADMINS=123456789

# Кому лично слать алерты о сбоях (ключ протух, кончилась квота, упал Telegram).
# ОДИН id, не список: это уведомления для того, кто платит за API, а не для всех
# админов канала. Пусто — алерты не отправляются, только пишутся в лог.
ALERT_CHAT_ID=123456789
# Одинаковые алерты не чаще раза в N часов (иначе мёртвый ключ даст по сообщению
# с каждого запуска: дайджест, разбор статьи, вечерний пост).
ALERT_REPEAT_HOURS=12

# Часовой пояс, по которому считается «вчера»
DIGEST_TZ=Europe/Moscow

# ---------------------------------------------------------------------------
# LLM. Все скрипты ходят в один OpenAI-совместимый эндпоинт /chat/completions,
# поэтому смена провайдера — это правка двух строк, без изменений в коде.
# ---------------------------------------------------------------------------

# Ключ Google AI Studio: https://aistudio.google.com/apikey
LLM_API_KEY=...
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Рабочая лошадка: ежедневный дайджест и недельный обзор.
LLM_MODEL=gemini-3.5-flash

# Другие провайдеры (тот же код, меняются только две строки):
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1              LLM_MODEL=deepseek-v4-flash
#   z.ai (GLM): LLM_BASE_URL=https://api.z.ai/api/paas/v4             LLM_MODEL=glm-5.2
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1             LLM_MODEL=google/gemini-3.5-flash

# Модели для отдельных скриптов. По умолчанию берут LLM_MODEL; для paper.py и
# vibe.py качество русского текста важнее экономии, поэтому модель посильнее.
PAPER_MODEL=gemini-3.7-flash
VIBE_MODEL=gemini-3.7-flash
TRENDS_MODEL=gemini-3.7-flash

# Gemini 3.x «думает» перед ответом, и размышления расходуют тот же бюджет
# max_tokens. Задача чисто редакторская, поэтому глубина минимальная.
# Допустимо: none|low|medium|high. Пусто — параметр не передаётся (нужно для
# провайдеров, которые его не понимают и отвечают 400).
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=600

# За сколько последних дней искать статьи в постах каналов для разбора.
PAPER_LOOKBACK_DAYS=3

# Как часто публиковать «живой» вечерний пост (раз в N дней).
# Окно времени задаётся в docker-compose.yml (VIBE_WINDOW_START/END).
VIBE_EVERY_DAYS=2
